{
  "name": "lemon-cat-app",
  "version": "0.1.0",
  "private": true,
  "description": "柠檬猫 - AI 数字桌宠 桌面应用（Electron 套壳）",
  "author": "cieLago",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:app": "electron-builder",
    "build:app:win": "electron-builder --win --publish never",
    "build:app:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cielago.lemoncat",
    "productName": "柠檬猫",
    "copyright": "Copyright © 2026 cieLago",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "柠檬猫-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "柠檬猫"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "柠檬猫-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "柠檬猫 ${version}"
    }
  }
}
