{
  "name": "pet-clone-demo",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "dev": "node scripts/dev-service.cjs",
    "service:setup": "node scripts/service-setup.cjs",
    "migrate": "node --env-file-if-exists=.env.1a.local scripts/migrate.cjs",
    "migrate:legacy": "node --env-file-if-exists=.env.1a.local scripts/migrate-legacy.cjs",
    "migrate:pets": "node --env-file-if-exists=.env.1a.local scripts/import-pets.cjs",
    "worker:build": "tsc -p tsconfig.worker.json",
    "verify:identity": "npm run worker:build && node --env-file-if-exists=.env.local --env-file-if-exists=.env.1a.local scripts/verify-pet-identity.cjs",
    "worker": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.1a.local .worker/scripts/worker.js",
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev:reset": "npm run clean && npm run dev",
    "dev:trae": "node scripts/trae-dev.mjs next",
    "dev:trae:all": "node scripts/trae-dev.mjs all",
    "dev:pet-shell": "node scripts/trae-dev.mjs shell",
    "pet:pick": "node scripts/pet-pick.mjs",
    "pet:run": "npm run pet:pick && npm run dev:pet-shell",
    "pet:kill": "node scripts/pet-kill.mjs",
    "build": "npm run worker:build && next build",
    "start": "node --env-file-if-exists=.env.1a.local node_modules/next/dist/bin/next start",
    "lint": "eslint app lib scripts app-shell --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "check:service": "node --env-file-if-exists=.env.1a.local scripts/check-service.cjs",
    "check:http": "node --env-file-if-exists=.env.1a.local scripts/check-http.cjs",
    "check:desktop": "node --env-file-if-exists=.env.1a.local scripts/check-desktop.cjs",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "husky install"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "dependencies": {
    "pg": "8.23.0",
    "pino": "10.3.1",
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "fluent-ffmpeg": "2.1.3",
    "jimp": "1.6.1",
    "next": "15.5.14",
    "onnxruntime-node": "1.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "undici": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.14",
    "husky": "8.0.3",
    "lint-staged": "16.4.0",
    "postcss": "8.5.8",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
