DASHSCOPE_API_KEY=your_dashscope_api_key_here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_VL_MODEL=qwen3-vl-plus
BAILIAN_IMAGE_MODEL=wan2.6-t2i
BAILIAN_PET_IMAGE_MODEL=qwen-image-edit-plus-2025-12-15
BAILIAN_IDENTITY_MODEL=qwen3-vl-plus
# AI 动画目前只用 DashScope Wan（MiniMax 已于 2026-06-04 撤回）。
DASHSCOPE_VIDEO_MODEL=wan2.6-i2v-flash
# Optional: default is derived from BAILIAN_BASE_URL
# DASHSCOPE_VIDEO_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# 1A service (local values are generated by npm run service:setup)
DATABASE_URL=
APP_ORIGIN=
REGISTRATION_CODE=
INITIAL_CREDITS=
LEMON_DATA_DIR=
ASSET_STORAGE=
# Private S3 storage. Supply credentials through environment/provider IAM only.
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
